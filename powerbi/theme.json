{
  "name": "Dark Premium",
  "dataColors": ["#2DD4BF", "#F59E0B", "#38BDF8", "#A78BFA", "#FB7185", "#4ADE80", "#FACC15", "#818CF8", "#F472B6", "#94A3B8"],
  "background": "#0E172A",
  "foreground": "#F1F5F9",
  "tableAccent": "#2DD4BF",
  "good": "#4ADE80",
  "neutral": "#F59E0B",
  "bad": "#FB7185",
  "maximum": "#2DD4BF",
  "center": "#1E3A5F",
  "minimum": "#0E172A",
  "foregroundNeutralSecondary": "#94A3B8",
  "foregroundNeutralTertiary": "#526179",
  "backgroundLight": "#16233B",
  "backgroundNeutral": "#1E2C46",
  "textClasses": {
    "callout": { "fontFace": "Segoe UI Bold", "fontSize": 26, "color": "#F1F5F9" },
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 11, "color": "#94A3B8" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 11, "color": "#E2E8F0" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#CBD5E1" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }],
        "dropShadow": [{ "show": false }],
        "title": [{ "show": false, "fontColor": { "solid": { "color": "#94A3B8" } } }],
        "categoryAxis": [{ "labelColor": { "solid": { "color": "#94A3B8" } }, "titleColor": { "solid": { "color": "#94A3B8" } }, "showAxisTitle": false, "gridlineShow": false }],
        "valueAxis": [{ "labelColor": { "solid": { "color": "#94A3B8" } }, "titleColor": { "solid": { "color": "#94A3B8" } }, "showAxisTitle": false, "gridlineColor": { "solid": { "color": "#1E2C46" } } }],
        "legend": [{ "labelColor": { "solid": { "color": "#CBD5E1" } } }],
        "labels": [{ "color": { "solid": { "color": "#E2E8F0" } } }],
        "visualTooltip": [{ "background": { "solid": { "color": "#16233B" } }, "titleFontColor": { "solid": { "color": "#94A3B8" } }, "valueFontColor": { "solid": { "color": "#F1F5F9" } } }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#070D1A" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#070D1A" } } }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "color": { "solid": { "color": "#F1F5F9" } }, "fontSize": 26 }],
        "categoryLabels": [{ "show": false }]
      }
    },
    "tableEx": {
      "*": {
        "grid": [{ "gridHorizontalColor": { "solid": { "color": "#1E2C46" } }, "gridVerticalShow": false, "outlineColor": { "solid": { "color": "#1E2C46" } } }],
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#94A3B8" } }, "backColor": { "solid": { "color": "#0E172A" } } }],
        "values": [{ "fontColorPrimary": { "solid": { "color": "#E2E8F0" } }, "backColorPrimary": { "solid": { "color": "#0E172A" } }, "fontColorSecondary": { "solid": { "color": "#E2E8F0" } }, "backColorSecondary": { "solid": { "color": "#111D33" } } }],
        "total": [{ "fontColor": { "solid": { "color": "#F1F5F9" } }, "backColor": { "solid": { "color": "#16233B" } } }]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [{ "gridHorizontalColor": { "solid": { "color": "#1E2C46" } }, "outlineColor": { "solid": { "color": "#1E2C46" } } }],
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#94A3B8" } }, "backColor": { "solid": { "color": "#0E172A" } } }],
        "rowHeaders": [{ "fontColor": { "solid": { "color": "#CBD5E1" } }, "backColor": { "solid": { "color": "#0E172A" } } }],
        "values": [{ "fontColorPrimary": { "solid": { "color": "#E2E8F0" } }, "backColorPrimary": { "solid": { "color": "#0E172A" } }, "backColorSecondary": { "solid": { "color": "#0E172A" } } }]
      }
    },
    "slicer": {
      "*": {
        "header": [{ "show": false }],
        "items": [{ "fontColor": { "solid": { "color": "#E2E8F0" } }, "background": { "solid": { "color": "#0E172A" } } }]
      }
    }
  }
}
